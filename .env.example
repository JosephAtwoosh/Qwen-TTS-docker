# Copy to .env and edit. Never commit a real key.
#
# ---------------------------------------------------------------- the service
# Shared secret the studio (or curl) must send as `Authorization: Bearer ...`.
# Leave empty only on a private network. Vast maps port 8000 to the public
# internet, so set this before renting.
TTS_API_KEY=change-me-before-you-rent

# Where the container listens.
HOST=0.0.0.0
PORT=8000

# Which engine: `qwen` for the real model, `mock` for a GPU-less smoke test.
ENGINE=qwen
MODEL_ID=/models/Qwen3-TTS-12Hz-1.7B-Base
DEVICE=cuda:0
DTYPE=bfloat16
# sdpa is the safe default. flash_attention_2 needs the optional extra build.
ATTN_IMPLEMENTATION=sdpa
PRELOAD_MODEL=1

# Sampling defaults. Any key here is forwarded to Transformers generate().
# GEN_KWARGS={"temperature":0.9,"top_k":50,"top_p":1.0,"repetition_penalty":1.05}
GEN_KWARGS=

# At most this many lines are generated in one model call. Lower it if a long
# scene runs out of VRAM; raise it on a 48 GB card.
MAX_BATCH=6
MAX_LINES=200

# Host folders (compose maps them to /models, /voices, /output).
MODELS_HOST_DIR=./models
VOICES_HOST_DIR=./voices
OUTPUT_HOST_DIR=./output

# ------------------------------------------------------------- voice import
# Only needed when you run `qwen-tts import-voices` / tools/import_voices.js.
ELEVENLABS_API_KEY=
# Optional transcript backend when the ElevenLabs key lacks speech_to_text.
OPENROUTER_API_KEY=
# Where imported references land on the host.
VOICES_PACK=./qwen-voices.tar.gz

# ------------------------------------------------------------------- image
# HF read token, only if a weight repo ever becomes gated.
HF_TOKEN=
